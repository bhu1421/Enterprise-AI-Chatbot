
# AWS Configuration
# Leave both empty when using an EC2 instance role. Set both for local AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="ap-south-1"
S3_BUCKET="your_s3_bucket_name"

# Active answer model (document chat)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Legacy Bedrock configuration (not used by the active chat pipeline)
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

# Pinecone Vector Database Configuration
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_NAME="your_pinecone_index_name"
PINECONE_CLOUD=aws
PINECONE_REGION=ap-south-1
PINECONE_READY_TIMEOUT=180
MIN_RELEVANCE=0.48
    
# PostgreSQL Database Configuration
DATABASE_URL="your_postgresql_database_url"

# RIUS Observability Configuration
RIUS_API_KEY="your_rius_api_key"
RIUS_SERVICE_NAME=atlas-ai-enterprise
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false
